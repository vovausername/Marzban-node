SERVICE_HOST = "0.0.0.0"
SERVICE_PORT = 62050

XRAY_API_HOST = "0.0.0.0"
XRAY_API_PORT = 62051
# XRAY_EXECUTABLE_PATH = /usr/local/bin/xray
# XRAY_ASSETS_PATH = /usr/local/share/xray

SSL_CERT_FILE = /var/lib/marzban-node/ssl_cert.pem
SSL_KEY_FILE = /var/lib/marzban-node/ssl_key.pem
SSL_CLIENT_CERT_FILE = /var/lib/marzban-node/ssl_client_cert.pem

### can be rest or rpyc
# SERVICE_PROTOCOL = rpyc

### for developers
# DEBUG = false

### Select Specific Inbounds
# INBOUNDS = "VLESS TCP REALITY, VMESS TCP NO TLS"

### Allow the panel to remotely replace the running Xray binary
### (see xray_updater.py). Enabled by default in this fork; set to
### false here to opt out.
# XRAY_REMOTE_UPDATE_ENABLED = true

### Allow the panel to temporarily block an IP via ipset/iptables
### (see ip_block.py). Enabled by default in this fork; set to false
### here to opt out. Requires NET_ADMIN/NET_RAW (docker-compose.yml) to
### actually work, and matters most if SSL_CLIENT_CERT_FILE is unset,
### since then any peer that can reach this service could otherwise
### poison the host firewall (main.py warns loudly in that case).
# IP_BLOCK_ENABLED = true

### Apply user additions/removals from the panel's restart calls to the
### live Xray process (see xray_hot_reload.py) instead of fully restarting
### it — a full restart drops every active user connection. Identical
### configs become a no-op; any change beyond inbound client lists, or any
### hot-path error, still triggers the plain full restart. Needs an Xray
### binary >= v25.7.26 (`xray api adu`/`rmu`); older binaries silently keep
### the full-restart behavior. Enabled by default in this fork; set to
### false here to opt out.
# XRAY_HOT_RELOAD_ENABLED = true

### Port of the loopback-only plaintext Xray API inbound used by hot
### reload (the `xray api` CLI can't speak TLS). Bound to 127.0.0.1, but
### with network_mode: host that's the host's loopback — change it if
### 62052 collides with something else on the host.
# XRAY_LOCAL_API_PORT = 62052

### Repo whose GitHub Releases are checked for a newer marzban-node version.
### Read-only: this process never updates itself, only reports availability.
# UPDATE_CHECK_REPO = vovausername/Marzban-node
