SERVICE_HOST = "0.0.0.0"
SERVICE_PORT = 62050

XRAY_API_HOST = "0.0.0.0"
XRAY_API_PORT = 62051
# XRAY_EXECUTABLE_PATH = /usr/local/bin/xray
# XRAY_ASSETS_PATH = /usr/local/share/xray

SSL_CERT_FILE = /var/lib/marzban-node/ssl_cert.pem
SSL_KEY_FILE = /var/lib/marzban-node/ssl_key.pem
SSL_CLIENT_CERT_FILE = /var/lib/marzban-node/ssl_client_cert.pem

### can be rest or rpyc
# SERVICE_PROTOCOL = rpyc

### for developers
# DEBUG = false

### Select Specific Inbounds
# INBOUNDS = "VLESS TCP REALITY, VMESS TCP NO TLS"

### Allow the panel to remotely replace the running Xray binary
### (see xray_updater.py). Off by default — swapping the proxy engine's
### binary is the highest-impact thing this node exposes.
# XRAY_REMOTE_UPDATE_ENABLED = false

### Repo whose GitHub Releases are checked for a newer marzban-node version.
### Read-only: this process never updates itself, only reports availability.
# UPDATE_CHECK_REPO = vovausername/Marzban-node
